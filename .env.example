# --- AI ---------------------------------------------------------------------
# Anthropic Claude API key — required for live AI chat.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (defaults to claude-opus-4-8)
# CHARACTER_AI_MODEL=claude-opus-4-8

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded SQLite file (great for local dev).
# Set it to a Postgres connection string to use Postgres (recommended for deploy).
#   e.g. postgres://user:password@host:5432/onlainchat
# DATABASE_URL=

# When your Postgres provider requires TLS (Supabase, Neon, RDS, …) either add
# ?sslmode=require to the URL or set:
# DATABASE_SSL=true

# Optional: max Postgres pool connections (default 10)
# PG_POOL_MAX=10

# Optional (SQLite only): path to the database file (default data/onlainchat.db)
# DATABASE_PATH=./data/onlainchat.db

# --- Email (password reset) -------------------------------------------------
# SMTP connection string used to email password-reset links. When unset, the
# reset link is written to the server log instead (and, outside production,
# returned in the API response so self-hosters can proceed without email).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=Character AI <no-reply@yourdomain.com>

# Public base URL used to build links in emails (recommended behind a proxy).
# Defaults to the incoming request's origin.
# APP_URL=https://your-domain.com

# --- Admin ------------------------------------------------------------------
# Comma-separated emails that are granted admin access to /admin. This is the
# zero-DB way to bootstrap the first admin; you can also set a user's role to
# 'admin' directly in the database.
# ADMIN_EMAILS=you@example.com,ops@example.com

# --- Email verification -----------------------------------------------------
# When "true", users must verify their email before creating characters.
# A verification email is always sent on sign-up regardless (logged to the
# console when SMTP is not configured). Default: false.
# REQUIRE_EMAIL_VERIFICATION=false

# --- Content moderation -----------------------------------------------------
# The baseline safety filter (sexualisation of minors) is always on. Add your
# own comma-separated blocked terms here to extend it for your policy.
# MODERATION_BLOCKLIST=term1,term2

# --- Rate limiting (multi-instance) -----------------------------------------
# Without REDIS_URL, rate limiting is per-instance (fine for a single server).
# Set a Redis/Upstash URL to enforce limits across all replicas.
# REDIS_URL=redis://default:password@host:6379

# --- Observability (Sentry) -------------------------------------------------
# Error tracking. All optional — with no DSN, Sentry is a complete no-op and
# adds nothing to the client bundle.
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX          # server/edge
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX  # browser
# SENTRY_TRACES_SAMPLE_RATE=0.1
# LOG_LEVEL=info   # debug | info | warn | error

# --- Analytics (privacy-friendly, optional) ---------------------------------
# Cookieless Plausible analytics. With no domain set, no script is loaded.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js  # or self-hosted

# --- Object storage for avatars (S3 / Cloudflare R2, optional) --------------
# Without these, avatars are stored inline as small data URLs (fine to start).
# Configure S3/R2 to offload images to object storage + CDN at scale.
# S3_BUCKET=my-bucket
# S3_REGION=auto                 # e.g. us-east-1, or "auto" for R2
# S3_ENDPOINT=                   # set for R2/MinIO, leave blank for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.your-domain.com   # base URL images are served from
