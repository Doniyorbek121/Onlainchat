# --- AI ---------------------------------------------------------------------
# Anthropic Claude API key — required for live AI chat.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (defaults to claude-opus-4-8)
# CHARACTER_AI_MODEL=claude-opus-4-8

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded SQLite file (great for local dev).
# Set it to a Postgres connection string to use Postgres (recommended for deploy).
#   e.g. postgres://user:password@host:5432/onlainchat
# DATABASE_URL=

# When your Postgres provider requires TLS (Supabase, Neon, RDS, …) either add
# ?sslmode=require to the URL or set:
# DATABASE_SSL=true

# Optional: max Postgres pool connections (default 10)
# PG_POOL_MAX=10

# Optional (SQLite only): path to the database file (default data/onlainchat.db)
# DATABASE_PATH=./data/onlainchat.db

# --- Email (password reset) -------------------------------------------------
# SMTP connection string used to email password-reset links. When unset, the
# reset link is written to the server log instead (and, outside production,
# returned in the API response so self-hosters can proceed without email).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=Character AI <no-reply@yourdomain.com>

# Public base URL used to build links in emails (recommended behind a proxy).
# Defaults to the incoming request's origin.
# APP_URL=https://your-domain.com

# --- Admin ------------------------------------------------------------------
# Comma-separated emails that are granted admin access to /admin. This is the
# zero-DB way to bootstrap the first admin; you can also set a user's role to
# 'admin' directly in the database.
# ADMIN_EMAILS=you@example.com,ops@example.com
